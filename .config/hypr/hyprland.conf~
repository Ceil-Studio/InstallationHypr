

# This config is a STUB! This should never be generated.
# Use the default lua config from https://github.com/hyprwm/Hyprland/blob/main/example/hyprland.lua

autogenerated = 0

# ----------------------------------------------------- 
# AUTOSTART
# ----------------------------------------------------- 
exec-once = waybar
exec-once = mako

env = LIBVA_DRIVER_NAME,nvidia
env = XDG_SESSION_TYPE,wayland
env = GBM_BACKEND,nvidia-drm
env = __GLX_VENDOR_LIBRARY_NAME,nvidia


env = QT_QPA_PLATFORM,wayland;xcb
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland

cursor {
    no_hardware_cursors = true
}
$mainMod = SUPER
$terminal = kitty
$fileManager = $terminal -e yazi
$menu = hyprlauncher

bind = $mainMod, Q, exec, $terminal
bind = $mainMod, C, killactive,
bind = $mainMod, M, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, L, exec, shutdown -h 0
bind = $mainMod, V, togglefloating,
bind = $mainMod, R, exec, $menu
input {
    kb_layout = fr
    kb_variant =
    kb_model =
    kb_options =
    kb_rules =

    follow_mouse = 1

    touchpad {
        natural_scroll = false
    }

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.
}
# ----------------------------------------------------- 
# MONITEURS
# ----------------------------------------------------- 
# Syntaxe : monitor=nom,résolution@fréquence,position,échelle
# Laisse le nom vide (monitor=,...) pour appliquer à tous les écrans par défaut.

monitor=,1920x1200@144,auto,1

img = /home/arch/Images/bg.jpg

preload = $img
wallpaper = ,$img
# ----------------------------------------------------- 
# ESPACES DE TRAVAIL (WORKSPACES) - AZERTY Keycodes
# ----------------------------------------------------- 
$mainMod = SUPER

# Basculer vers l'espace de travail avec Super + [touches 1 à 0]
bind = $mainMod, code:10, workspace, 1
bind = $mainMod, code:11, workspace, 2
bind = $mainMod, code:12, workspace, 3
bind = $mainMod, code:13, workspace, 4
bind = $mainMod, code:14, workspace, 5
bind = $mainMod, code:15, workspace, 6
bind = $mainMod, code:16, workspace, 7
bind = $mainMod, code:17, workspace, 8
bind = $mainMod, code:18, workspace, 9
bind = $mainMod, code:19, workspace, 10

# Déplacer la fenêtre active vers un espace de travail avec Super + Shift + [touches 1 à 0]
bind = $mainMod SHIFT, code:10, movetoworkspace, 1
bind = $mainMod SHIFT, code:11, movetoworkspace, 2
bind = $mainMod SHIFT, code:12, movetoworkspace, 3
bind = $mainMod SHIFT, code:13, movetoworkspace, 4
bind = $mainMod SHIFT, code:14, movetoworkspace, 5
bind = $mainMod SHIFT, code:15, movetoworkspace, 6
bind = $mainMod SHIFT, code:16, movetoworkspace, 7
bind = $mainMod SHIFT, code:17, movetoworkspace, 8
bind = $mainMod SHIFT, code:18, movetoworkspace, 9
bind = $mainMod SHIFT, code:19, movetoworkspace, 10

# Raccourcis divers
bind = $mainMod, T, exec, chromium


# Basculer la fenêtre active en plein écran (toggle) avec Super + F
bind = $mainMod, F, fullscreen

# Déplacer la fenêtre en maintenant Super + Clic Gauche et en glissant
bindm = $mainMod, mouse:272, movewindow
# ----------------------------------------------------- 
# CAPTURE D'ÉCRAN (NATIVE WAYLAND)
# ----------------------------------------------------- 
# Touche Print : Sélectionne une zone à la souris et copie dans le presse-papier
bind = , F6, exec, grim -g "$(slurp)" - | wl-copy

# Shift + Print : Capture l'intégralité de l'écran et copie dans le presse-papier
bind = SHIFT, F6, exec, grim - | wl-copy


# Règles Twitch Overlay (Méthode souple pour Hyprland 0.53+)
windowrule = float 1, match:title twitch_overlay
windowrule = pin 1, match:title twitch_overlay
windowrule = no_focus 1, match:title twitch_overlay
windowrule = no_initial_focus 1, match:title twitch_overlay
windowrule = move 0 0, match:title twitch_overlay
windowrule = size 350 1080, match:title twitch_overlay

windowrule = float 1, match:class twitch_overlay
