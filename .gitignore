# Ignorer tout le dossier .config par défaut
.config/*

# Whitelister les configs dont tu as besoin
!.config/hypr/
!.config/waybar/
!.config/yazi/
!.config/blender/
!.config/xdg-desktop-portal/
!.config/gtk-3.0/
!.config/gtk-4.0/

# Tes règles Chromium actuelles (uniquement les Bookmarks)
!.config/chromium/
.config/chromium/*
!.config/chromium/Default/
.config/chromium/Default/*
!.config/chromium/Default/Bookmarks

# Fichiers de sauvegarde et temporaires
*.bak
*~
*.log
__pycache__/
*.pyc

# Sécurité SSH : bloquer toute clé privée ou certificat accidentel
.ssh/id_*
.ssh/*.key
.ssh/*.pem

# Antigravity CLI : ne suivre que le dossier de configuration (règles et skills)
.gemini/*
!.gemini/config/
