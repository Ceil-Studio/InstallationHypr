{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 8,
    "exclusive": true,

    "modules-left": [
        "group/tmux",
        "group/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "group/hardware",
        "group/control",
        "group/power",
        "clock",
        "tray"
    ],

    /* ─── TIROIR TMUX ─── */
    "group/tmux": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "tmux-drawer-child",
            "transition-left-to-right": true,
            "click-to-reveal": false
        },
        "modules": [
            "custom/tmux",
            "custom/tmux-new",
            "custom/tmux-attach",
            "custom/tmux-picker",
            "custom/tmux-kill"
        ]
    },
    "custom/tmux": {
        "format": "{}",
        "exec": "~/.config/waybar/tmux_status.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "kitty -e tmux",
        "on-click-right": "kitty -e tmux a",
        "tooltip": true
    },
    "custom/tmux-new": {
        "format": "󰐕",
        "tooltip": true,
        "tooltip-format": "Nouveau tmux",
        "on-click": "kitty -e tmux"
    },
    "custom/tmux-attach": {
        "format": "󰁌",
        "tooltip": true,
        "tooltip-format": "Rattacher la dernière session détachée (tmux a)",
        "on-click": "kitty -e tmux a"
    },
    "custom/tmux-picker": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Choisir une session (liste)",
        "on-click": "~/.config/waybar/tmux_picker.sh"
    },
    "custom/tmux-kill": {
        "format": "󰅖",
        "tooltip": true,
        "tooltip-format": "Fermer les sessions détachées",
        "on-click": "~/.config/waybar/tmux_kill.sh"
    },

    /* ─── CAPSULE WORKSPACES UNIFIÉE ─── */
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/ws1",
            "custom/ws2",
            "custom/ws3",
            "custom/ws4",
            "custom/ws5",
            "custom/ws6",
            "custom/ws7",
            "custom/ws8",
            "custom/ws9",
            "custom/ws10"
        ]
    },
    "custom/ws1": {
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=1})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "exec": "~/.config/waybar/ws_state.sh 1 ",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "tooltip": true
    },
    "custom/ws2": {
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=2})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "exec": "~/.config/waybar/ws_state.sh 2 ",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "tooltip": true
    },
    "custom/ws3": {
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=3})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "exec": "~/.config/waybar/ws_state.sh 3 ",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "tooltip": true
    },
    "custom/ws4": {
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=4})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "exec": "~/.config/waybar/ws_state.sh 4 ",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "tooltip": true
    },
    "custom/ws5": {
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=5})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "exec": "~/.config/waybar/ws_state.sh 5 ",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "tooltip": true
    },
    "custom/ws6": {
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=6})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "exec": "~/.config/waybar/ws_state.sh 6 ",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "tooltip": true
    },
    "custom/ws7": {
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=7})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "exec": "~/.config/waybar/ws_state.sh 7 ",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "tooltip": true
    },
    "custom/ws8": {
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=8})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "exec": "~/.config/waybar/ws_state.sh 8 ",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "tooltip": true
    },
    "custom/ws9": {
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=9})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "exec": "~/.config/waybar/ws_state.sh 9 ",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "tooltip": true
    },
    "custom/ws10": {
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=10})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "exec": "~/.config/waybar/ws_state.sh 10 ",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "tooltip": true
    },

    /* ─── FENÊTRE ACTIVE ─── */
    "hyprland/window": {
        "format": "{title}",
        "max-length": 38,
        "rewrite": {
            "(.*) - NVIM": "  $1",
            "(.*) - Blender": "  $1",
            "(.*) - Garry's Mod": "  $1",
            "(.*) — Mozilla Firefox": "  $1",
            "(.*) - Brave": "  $1",
            "(.*) - Chromium": "  $1",
            "(.*) - Discord": "  $1",
            "^kitty$": "  Terminal",
            "^tmux$": "  Tmux"
        },
        "separate-outputs": true
    },

    /* ─── MÉDIA (CENTRE) ─── */
    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon}  <i>{dynamic}</i>",
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 35,
        "player-icons": {
            "default": "󰐊",
            "spotify": "",
            "mpd": ""
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    /* ─── TIROIR SYSTÈME (CPU visible -> RAM + TEMP au survol) ─── */
    "group/hardware": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "hw-drawer-child",
            "transition-left-to-right": false
        },
        "modules": [
            "cpu",
            "memory",
            "temperature"
        ]
    },
    "cpu": {
        "interval": 3,
        "format": " {usage}%",
        "tooltip": true,
        "tooltip-format": "Processeur : {usage}%\nFréquence moy. : {avg_frequency} GHz\n\n• Clic : Ouvrir htop",
        "on-click": "kitty -e htop"
    },
    "memory": {
        "interval": 5,
        "format": "󰍛 {percentage}%",
        "tooltip": true,
        "tooltip-format": "RAM : {used:0.1f} Go / {total:0.1f} Go ({percentage}%)\nSwap : {swapUsed:0.1f} Go / {swapTotal:0.1f} Go ({swapPercentage}%)\n\n• Clic : Ouvrir htop",
        "on-click": "kitty -e htop"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""],
        "tooltip-format": "Température : {temperatureC}°C"
    },

    /* ─── CAPSULE CONTRÔLES (Audio + Luminosité + Réseau + Bluetooth) ─── */
    "group/control": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "backlight",
            "network",
            "bluetooth"
        ]
    },
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂰 {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "tooltip-format": "{desc}\nVolume : {volume}%\n\n• Clic gauche : Muet\n• Clic droit : Pavucontrol\n• Molette : ±5%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Luminosité : {percent}%\n\n• Molette : ±5%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤮",
        "format-alt": "{icon} {essid} ({signalStrength}%)",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "  {essid} ({signalStrength}%)\n󰩟  IP : {ipaddr}\n󰛳  Passerelle : {gwaddr}\n󰌗  Interface : {ifname}\n\n• Clic gauche : Basculer nom Wi-Fi\n• Clic droit : Ouvrir nmtui",
        "tooltip-format-ethernet": "󰈀  Ethernet ({ifname})\n󰩟  IP : {ipaddr}/{cidr}\n󰛳  Passerelle : {gwaddr}\n\n• Clic droit : Ouvrir nmtui",
        "tooltip-format-disconnected": "󰤮  Réseau déconnecté\n\n• Clic droit : Ouvrir nmtui",
        "on-click-right": "kitty -e nmtui"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "Bluetooth : {status}\nContrôleur : {controller_alias}\n\n• Clic : Ouvrir bluetoothctl",
        "tooltip-format-connected": "Bluetooth ({num_connections} connecté(s))\n{device_enumerate}\n\n• Clic : Ouvrir bluetoothctl",
        "tooltip-format-enumerate-connected": "• {device_alias} ({device_address})",
        "tooltip-format-enumerate-connected-battery": "• {device_alias} ({device_battery_percentage}%)",
        "on-click": "kitty -e bluetoothctl"
    },

    /* ─── CAPSULE ÉNERGIE (Batterie + Profil d'alimentation) ─── */
    "group/power": {
        "orientation": "horizontal",
        "modules": [
            "battery",
            "power-profiles-daemon"
        ]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "Batterie : {capacity}%\nAutonomie : {timeTo}\nPuissance : {power:0.1f} W\n\n• Clic : Afficher temps restant"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Profil d'énergie : {profile}\nPilote : {driver}\n\n• Clic : Changer de profil",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    /* ─── HORLOGE ─── */
    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%a %d %b  •  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cdd6f4'><b>{}</b></span>",
                "days": "<span color='#bac2de'><b>{}</b></span>",
                "weeks": "<span color='#6c7086'><b>W{}</b></span>",
                "weekdays": "<span color='#fab387'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode"
        }
    },

    /* ─── TRAY ─── */
    "tray": {
        "icon-size": 18,
        "spacing": 8
    }
}
